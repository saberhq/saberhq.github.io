{{- /* A page for every song on the wall or among the liked songs; a song Saber has written about (<name>.md here) keeps that file as its page. */ -}}
{{- $songs := slice -}}
{{- $more := (.Site.Data.vibes_more | default dict).songs | default dict -}}
{{- range (.Site.Data.vibes | default dict).tracks -}}
  {{- if and (reflect.IsMap .) .id .name -}}
    {{- $name := .name -}}
    {{- $names := slice -}}
    {{- range .artists }}{{ with .name }}{{ $names = $names | append . }}{{ end }}{{ end -}}
    {{- with (index $more .id | default dict).slug -}}
      {{- $songs = $songs | append (dict "slug" . "name" $name "by" (delimit $names ", ")) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range (.Site.Data.albumarts | default dict).tiles -}}
  {{- if and (reflect.IsMap .) .slug .name -}}
    {{- $songs = $songs | append (dict "slug" .slug "name" .name "by" .by) -}}
  {{- end -}}
{{- end -}}
{{- $seen := dict -}}
{{- range $songs -}}
  {{- if and (not (index $seen .slug)) (not (fileExists (printf "content/songs/%s.md" .slug))) (not (fileExists (printf "content/songs/%s/index.md" .slug))) -}}
    {{- $.AddPage (dict
      "path" .slug
      "title" .name
      "description" (printf "%s%s, a song in Saber Vibes." .name (cond (ne .by "") (printf " by %s" .by) ""))
      "params" (dict "bookSearchExclude" true)
      "sitemap" (dict "disable" true)
    ) -}}
  {{- end -}}
  {{- $seen = merge $seen (dict .slug true) -}}
{{- end -}}
